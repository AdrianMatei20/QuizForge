# Loaded instead of .env when NODE_ENV=test (Vitest sets this). Committed on purpose:
# it holds no secrets, and it points e2e tests at a separate database.
NODE_ENV=test
PORT=3001
API_DOCS_ENABLED=true
DATABASE_URL=postgres://quizforge:quizforge@localhost:5432/quizforge_test
REDIS_URL=redis://localhost:6379
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=fake-model
LLM_JUDGE_MODEL=fake-judge-model
LLM_DAILY_BUDGET_USD=1.00
LLM_CACHE_TTL_SECONDS=60
LLM_TIMEOUT_MS=5000
LLM_RETRY_AFTER_MAX_MS=1000
# A few milliseconds, so e2e tests can exhaust every retry quickly.
LLM_RETRY_BASE_DELAY_MS=5
LLM_RETRY_MAX_DELAY_MS=20
LLM_PRICING_FILE=config/llm-pricing.json
QUIZ_SOURCE_QUOTE_MIN_WORDS=5
QUIZ_GENERATION_TIMEOUT_MS=180000
QUIZ_STUCK_SWEEP_INTERVAL_MS=300000
# High, so ordinary e2e tests are never throttled; the throttling test sets its own limit.
THROTTLE_GENERATE_LIMIT=1000
THROTTLE_GENERATE_TTL_MS=60000
THROTTLE_ATTEMPT_LIMIT=1000
THROTTLE_ATTEMPT_TTL_MS=60000
ATTEMPT_FLAG_TOO_EASY_ABOVE=0.9
ATTEMPT_FLAG_POSSIBLY_WRONG_BELOW=0.2
ATTEMPT_FLAG_MIN_ATTEMPTS=5
OTEL_EXPORTER_OTLP_ENDPOINT=
