# Loaded instead of .env when NODE_ENV=test (Vitest sets this). Committed on purpose:
# it holds no secrets, and it points e2e tests at a separate database.
NODE_ENV=test
PORT=3001
DATABASE_URL=postgres://quizforge:quizforge@localhost:5432/quizforge_test
REDIS_URL=redis://localhost:6379
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=fake-model
LLM_JUDGE_MODEL=fake-judge-model
LLM_DAILY_BUDGET_USD=1.00
LLM_CACHE_TTL_SECONDS=60
