# Copy to .env.live.local (gitignored) to run `npm run test:live`.
# Real environment variables take precedence over this file.
# The live test makes one tiny real call, which costs a fraction of a cent.
LLM_API_KEY=
# Must be a real Anthropic model ID with an entry in config/llm-pricing.json.
LLM_MODEL=claude-haiku-5-5
