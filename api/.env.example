# Copy to .env and adjust. Every variable is validated at startup (src/config/env.schema.ts);
# the API refuses to start and names the bad variable if anything is invalid.

NODE_ENV=development
PORT=3000
# Serve Swagger UI at /docs and the OpenAPI spec at /docs-json. Turn off where the API should not describe itself.
API_DOCS_ENABLED=true

# Matches docker-compose.yml at the repo root.
DATABASE_URL=postgres://quizforge:quizforge@localhost:5432/quizforge
REDIS_URL=redis://localhost:6379

# "fake" needs no API key and makes no network calls. Use "anthropic" for real calls.
LLM_PROVIDER=fake
# Required unless LLM_PROVIDER=fake. Never commit a real key.
LLM_API_KEY=
# Model IDs always come from config. With LLM_PROVIDER=anthropic, set real Anthropic model IDs.
LLM_MODEL=fake-model
LLM_JUDGE_MODEL=fake-judge-model
# Decimal USD amount, kept as a string so it is never handled as a float.
LLM_DAILY_BUDGET_USD=5.00
# Seconds a validated result stays in Redis. 0 disables the cache.
LLM_CACHE_TTL_SECONDS=86400
# Per provider call; each retry gets the full timeout again.
LLM_TIMEOUT_MS=60000
# A provider's Retry-After header delays the next attempt by at most this much.
LLM_RETRY_AFTER_MAX_MS=10000
# Backoff between retries: a random delay up to base * 2^(attempt - 1), capped at the max.
LLM_RETRY_BASE_DELAY_MS=500
LLM_RETRY_MAX_DELAY_MS=8000
# Model ID -> USD price per million input/output tokens. Unknown models cost 0 (with a warning).
LLM_PRICING_FILE=config/llm-pricing.json
# A generated question's sourceQuote must have at least this many words (and appear in the lesson).
QUIZ_SOURCE_QUOTE_MIN_WORDS=5
