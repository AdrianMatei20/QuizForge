# Copy to .env and adjust. Every variable is validated at startup (src/config/env.schema.ts);
# the API refuses to start and names the bad variable if anything is invalid.

NODE_ENV=development
PORT=3000
# Serve Swagger UI at /docs and the OpenAPI spec at /docs-json. Turn off where the API should not describe itself.
API_DOCS_ENABLED=true
# Reverse proxies in front of the API: 0 locally, 1 behind the web container's nginx (rate limits use the client IP).
TRUST_PROXY_HOPS=0

# Matches docker-compose.yml at the repo root.
DATABASE_URL=postgres://quizforge:quizforge@localhost:5432/quizforge
REDIS_URL=redis://localhost:6379

# "fake" needs no API key and makes no network calls. Use "anthropic" for real calls.
LLM_PROVIDER=fake
# Required unless LLM_PROVIDER=fake. Never commit a real key.
LLM_API_KEY=
# Model IDs always come from config. With LLM_PROVIDER=anthropic, set real Anthropic model IDs.
LLM_MODEL=fake-model
LLM_JUDGE_MODEL=fake-judge-model
# Decimal USD amount, kept as a string so it is never handled as a float.
LLM_DAILY_BUDGET_USD=5.00
# Seconds a validated result stays in Redis. 0 disables the cache.
LLM_CACHE_TTL_SECONDS=86400
# Per provider call; each retry gets the full timeout again.
LLM_TIMEOUT_MS=60000
# A provider's Retry-After header delays the next attempt by at most this much.
LLM_RETRY_AFTER_MAX_MS=10000
# Backoff between retries: a random delay up to base * 2^(attempt - 1), capped at the max.
LLM_RETRY_BASE_DELAY_MS=500
LLM_RETRY_MAX_DELAY_MS=8000
# Model ID -> USD price per million input/output tokens. Unknown models cost 0 (with a warning).
# With LLM_PROVIDER=fake: only the sample lessons in fixtures/lessons can be used (others get a 422).
FAKE_LLM_SAMPLE_LESSONS_ONLY=true
LLM_PRICING_FILE=config/llm-pricing.json
# A generated question's sourceQuote must have at least this many words (and appear in the lesson).
QUIZ_SOURCE_QUOTE_MIN_WORDS=5
# A streamed quiz's generation is aborted after this long. Quizzes still "generating" this long
# (plus a minute) after creation, e.g. after a crash, are cleaned up every QUIZ_STUCK_SWEEP_INTERVAL_MS.
QUIZ_GENERATION_TIMEOUT_MS=180000
QUIZ_STUCK_SWEEP_INTERVAL_MS=300000
# Generate and regenerate: at most this many requests per window, per client IP (429 problem details after that).
THROTTLE_GENERATE_LIMIT=10
THROTTLE_GENERATE_TTL_MS=60000
# Submitting quiz attempts (public, no login): at most this many per window, per client IP.
THROTTLE_ATTEMPT_LIMIT=20
THROTTLE_ATTEMPT_TTL_MS=60000
# Attempt stats: flag a question as possibly too easy above this share correct, possibly wrong or unclear below
# the lower one (shares from 0 to 1), once it has at least ATTEMPT_FLAG_MIN_ATTEMPTS attempts.
ATTEMPT_FLAG_TOO_EASY_ABOVE=0.9
ATTEMPT_FLAG_POSSIBLY_WRONG_BELOW=0.2
ATTEMPT_FLAG_MIN_ATTEMPTS=5
# Tracing (OpenTelemetry, OTLP over HTTP). Off when empty. With `docker compose --profile observability up -d`,
# use http://localhost:4318 and start the API with `npm run start:traced` (or start:prod).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=quizforge-api
